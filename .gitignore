# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS auf FAT-Laufwerken
._*
.DS_Store

# QA
qa-reports/
test-results/
playwright-report/
.lighthouseci/

# lokale Hilfsskripte fuer Screenshots
.*.mjs

# 4K-Zwischendateien der Hochskalierung (nur lokal)
public/arbeiten-4k/

# Projektordner: Rohvideo bleibt lokal
projekt/video/*
!projekt/video/.gitkeep

# Druckdaten: Abhängigkeiten, erzeugte PDFs/PNGs und ECI-Profile (Lizenz der ECI, per profile/laden.sh)
druck/node_modules/
druck/ausgabe/
druck/profile/*.icc
